{
  "name": "ContactMessage",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "reason": {
      "type": "string",
      "enum": [
        "Product feedback",
        "Press",
        "Partnerships",
        "Support",
        "General inquiry"
      ]
    },
    "message": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "email",
    "message"
  ]
}