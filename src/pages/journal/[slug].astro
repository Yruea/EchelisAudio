---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const entries = await getCollection('journal', (e) => !e.data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const date = entry.data.date.toISOString().slice(0, 10);
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: entry.data.title,
    datePublished: date,
    description: entry.data.summary,
    author: { '@type': 'Organization', name: site.name },
  },
];
---

<Base title={entry.data.title} description={entry.data.summary} schema={schema}>
  <article class="wrap entry">
    <header class="entry__head">
      <p class="label">
        Log {String(entry.data.log).padStart(3, '0')} · <time datetime={date}>{date}</time> · {entry.data.tag}
      </p>
      <h1 class="h2">{entry.data.title}</h1>
      <p class="lead">{entry.data.summary}</p>
    </header>
    <div class="entry__body prose">
      <Content />
    </div>
    <p><a class="label label--text entry__back" href="/journal">← All entries</a></p>
  </article>
</Base>

<style>
  .entry {
    display: grid;
    gap: var(--space-7);
    padding-block: var(--space-9);
  }
  .entry__head {
    display: grid;
    gap: var(--space-5);
  }
  .entry__back {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
  }
  /* lab-note headings: small mono labels above ruled blocks */
  .entry__body :global(h2) {
    margin-top: var(--space-7);
    padding-top: var(--space-4);
    border-top: var(--hairline) solid var(--line);
    font-family: var(--font-mono);
    font-size: var(--type-label);
    line-height: var(--lh-label);
    letter-spacing: var(--track-label);
    font-weight: var(--weight-medium);
    text-transform: uppercase;
    color: var(--muted);
  }
  .entry__body :global(ul) {
    display: grid;
    gap: var(--space-2);
    padding-left: var(--space-5);
    list-style: square;
  }
  .entry__body :global(li::marker) {
    color: var(--accent);
  }
</style>
