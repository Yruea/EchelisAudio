---
// The signature: a thin frequency-curve line. Decorative only (not real
// measurement data). The stroke runs low → mid → high across the three
// signal colours.
interface Props {
  class?: string;
  id: string;
  draw?: boolean;
}
const { class: className, id, draw = false } = Astro.props;
---

<svg
  class:list={['freq', className, { 'freq--draw': draw }]}
  viewBox="0 0 1200 64"
  preserveAspectRatio="none"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id={`freq-${id}`} x1="0" x2="1" y1="0" y2="0">
      <stop offset="0" stop-color="var(--signal-low)"></stop>
      <stop offset="0.5" stop-color="var(--signal-mid)"></stop>
      <stop offset="1" stop-color="var(--signal-high)"></stop>
    </linearGradient>
  </defs>
  <path
    pathLength="1"
    d="M0 44C90 44 150 42 230 37S380 18 470 23S600 44 690 37S820 6 910 13S1020 50 1090 56S1160 58 1200 58"
    fill="none"
    stroke={`url(#freq-${id})`}
    stroke-width="1.5"
    vector-effect="non-scaling-stroke"></path>
</svg>

<style>
  .freq {
    width: 100%;
    height: var(--space-7);
  }
  .freq--draw path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  :global(.is-drawn) .freq--draw path,
  .freq--draw:global(.is-drawn) path {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset var(--dur-4) var(--ease-mech);
  }
</style>
