---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, product } from '../data/site';

interface Props {
  title: string;
  description?: string;
  stage?: boolean;
  noindex?: boolean;
  schema?: Record<string, unknown>[];
}
const { title, description = site.description, stage = false, noindex = false, schema = [] } = Astro.props;
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '').replace(/\/$/, '');
const canonical = new URL(path || '/', site.url).href;
const fullTitle = title === site.name ? `${site.name}: ${product.name}, built in the open` : `${title} · ${site.name}`;
const ogImage = new URL('/og.png', site.url).href;
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: site.url,
  logo: new URL('/icon-512.png', site.url).href,
  email: site.email,
  foundingDate: '2026-07',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0e0e0d" />
    <link rel="preload" href="/fonts/geist.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-mono.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Echelis wordmark above a thin frequency line" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {[organization, ...schema].map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
    {
      stage && (
        <script is:inline>
          // Turn on the pinned 3D stage before first paint, only when motion is
          // allowed and WebGL exists. Otherwise the static layout stays.
          try {
            if (
              matchMedia('(prefers-reduced-motion: no-preference)').matches &&
              document.createElement('canvas').getContext('webgl2')
            )
              document.documentElement.classList.add('stage-on');
          } catch (e) {}
        </script>
      )
    }
    <script is:inline>
      window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
    </script>
    <script is:inline defer src="/_vercel/insights/script.js"></script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
