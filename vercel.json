{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/product/:slug*", "destination": "/angostura-uno", "permanent": true },
    { "source": "/shop", "destination": "/angostura-uno", "permanent": true },
    { "source": "/engineering", "destination": "/angostura-uno", "permanent": true },
    { "source": "/faq", "destination": "/angostura-uno#faq", "permanent": true },
    { "source": "/contact", "destination": "/about#contact", "permanent": true },
    { "source": "/journal/why-we-tune-by-ear", "destination": "/journal", "permanent": false },
    { "source": "/journal/the-case-for-detachable-cables", "destination": "/journal", "permanent": false },
    { "source": "/journal/building-in-public", "destination": "/journal", "permanent": false },
    { "source": "/(cart|checkout|signin|account|forgot-password|reset-password|shipping-returns|warranty|terms|accessibility)", "destination": "/", "permanent": false }
  ],
  "headers": [
    { "source": "/fonts/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/_astro/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
